# Paths may be absolute, relative to this project, or begin with ~.
BENCHMARK_SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
BENCHMARK_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Optional Google Cloud discovery defaults. ADC remains the credential source.
GCP_PROJECT_ID=
GCP_DEFAULT_REGION=us-east1

# Optional Azure discovery defaults. Azure CLI remains the credential source.
AZURE_SUBSCRIPTION_ID=
AZURE_DEFAULT_REGION=eastus2
